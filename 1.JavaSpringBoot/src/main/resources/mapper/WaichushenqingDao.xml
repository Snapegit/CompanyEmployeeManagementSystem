<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.WaichushenqingDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.WaichushenqingEntity" id="waichushenqingMap">
        <result property="zhanghao" column="zhanghao"/>
        <result property="xingming" column="xingming"/>
        <result property="shouji" column="shouji"/>
        <result property="gangwei" column="gangwei"/>
        <result property="bumenmingcheng" column="bumenmingcheng"/>
        <result property="bumenbianhao" column="bumenbianhao"/>
        <result property="bumenfuzeren" column="bumenfuzeren"/>
        <result property="bumenlianxidianhua" column="bumenlianxidianhua"/>
        <result property="waichukaishishijian" column="waichukaishishijian"/>
        <result property="waichujieshushijian" column="waichujieshushijian"/>
        <result property="waichufaqiriqi" column="waichufaqiriqi"/>
        <result property="shhf" column="shhf"/>
        <result property="sfsh" column="sfsh"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.WaichushenqingView" >

		SELECT  waichushenqing.* FROM waichushenqing  waichushenqing 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.WaichushenqingView" >
		SELECT * FROM waichushenqing  waichushenqing <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

    <select id="selectValue" resultType="map" >
        SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM waichushenqing
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.xColumn}
        limit 10
    </select>

    <select id="selectTimeStatValue" resultType="map" >
        <if test = 'params.timeStatType == "日"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM waichushenqing
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
        </if>
        <if test = 'params.timeStatType == "月"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM waichushenqing
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m')
        </if>
        <if test = 'params.timeStatType == "年"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM waichushenqing
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y')
        </if>
    </select>

    <select id="selectGroup" resultType="map" >
        SELECT ${params.column} , count(1) total FROM waichushenqing
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.column}
        limit 10
    </select>



</mapper>
